# ==================================================
# PIXORA Monorepo .gitignore
# ==================================================

# Dependencies
node_modules/
/node_modules/
frontend/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js / Frontend
.next/
/.next/
frontend/.next/
out/
/out/
build/
/build/
*.tsbuildinfo
tsconfig.tsbuildinfo
frontend/tsconfig.tsbuildinfo
next-env.d.ts

# Python / Backend
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
/.pytest_cache/
backend/.pytest_cache/
uploads/
*.log

# Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*

# Testing & Coverage
coverage/
/coverage/

# OS / Editor
.DS_Store
Thumbs.db
*.pem
.vercel

# Temporary / Scratch
scratch/
*.png.tmp
